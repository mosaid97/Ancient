# Python build artifacts
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables (use .env.example as a template)
.env

# Raw corpus (large + not redistributable)
raw/

# Data blobs (keep data/seeds/ and data/bench/; exclude large binary dumps)
data/blobs/
data/paddle_corpus/
data/*.db

# Evaluation outputs (generated at runtime)
eval_out/

# Logs (generated at runtime — keep the placeholder, ignore everything else)
logs/*
!logs/.gitkeep

# Notebooks (exploratory artifacts — not part of the shipped pipeline)
notebooks/

# Internal contributor documentation (not part of the public release)
AGENTS.md
CLAUDE.md
docs/superpowers/
docs/feature-layout-analysis-*.md

# macOS
.DS_Store

# Docker volumes (Neo4j, MinIO)
neo4j_data/
neo4j_logs/
neo4j_import/
minio_data/

# IDE / tooling config (not useful to contributors)
.cursor/
.claude/
.mcp.json
.idea/
.pytest_cache/
*.swp
*.swo

# Graphify knowledge-graph outputs (generated, not source)
graphify-out/

# Staging area for in-progress files
staging/
