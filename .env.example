# --- LLM (Silra, OpenAI-compatible) ---
LLM_API_KEY=sk-your-silra-key
LLM_BASE_URL=https://api.silra.cn/v1/
OCR_LLM_MODEL=deepseek-ocr
EMBED_LLM_MODEL=text-embedding-v4
CHAT_LLM_MODEL=deepseek-chat
EMBEDDING_DIMS=1024

# --- Neo4j (Docker bootstrap admin MUST be "neo4j") ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_INSTANCE_ID=00000000-0000-0000-0000-000000000000

# --- Redis (search/HITL queues) ---
# REDIS_PASSWORD is required by docker-compose; leave empty only on a
# trusted single-user dev box. The REDIS_URL must include the password
# when one is set.
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0

# --- MinIO (S3-compatible object store for raw + artifacts) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=ancient

# --- Postgres (auth / app metadata) ---
POSTGRES_USER=ancientadmin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ancient_auth
DATABASE_URL=postgresql+asyncpg://ancientadmin:change-me@localhost:5432/ancient_auth

# --- Optional: Qwen-VL OCR (3rd OCR engine) ---
QWEN_VL_API_KEY=

# --- Optional: re-ranker (BAAI/bge-reranker-v2-gemma) ---
RERANKER_MODEL_DIR=~/.cache/huggingface/hub/models--BAAI--bge-reranker-v2-gemma
